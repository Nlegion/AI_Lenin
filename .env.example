# Required for Telegram publish path
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_ID=

# Optional / unused on VPS hot path
# NEWSAPI_KEY=
# HUGGINGFACE_TOKEN=

# --- Local llama.cpp (default) ---
# LLM_SPAWN_LOCAL=true
# LLM_PROVIDER=llama

# --- DeepSeek remote (from local PC or VPS; mutually exclusive with local llama-server) ---
LLM_SPAWN_LOCAL=false
LLM_PROVIDER=deepseek
# GENERATION_SERVER_URL defaults to https://api.deepseek.com when provider=deepseek
# GENERATION_SERVER_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Optional generic override (wins over DEEPSEEK_API_KEY when set):
# LLM_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash
# Trusted HTTP proxy escape hatch (default: HTTPS-only):
# LLM_DEEPSEEK_ALLOW_INSECURE_URL=false

# --- Generic OpenAI-compatible remote (provider=llama, spawn_local=false) ---
# LLM_SPAWN_LOCAL=false
# LLM_PROVIDER=llama
# GENERATION_SERVER_URL=https://api.example.com
# LLM_API_KEY=
# LLM_MODEL_NAME=your-model-id
